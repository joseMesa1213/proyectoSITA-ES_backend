# Copiar a .env y completar. Las URLs están en Supabase → Project Settings → Database → Connection string.

# Conexión por pooler (puerto 6543) — la usa la app en ejecución
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) — la usa la CLI de Prisma (migraciones)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORT=3000
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"
# Origen del frontend (Vite)
CORS_ORIGIN="http://localhost:5173"
