// =============================================================================
// SITA-ES — Esquema Prisma
// Refleja la base desplegada en Supabase (PostgreSQL).
// Modelos en PascalCase singular; tablas y columnas reales en minúscula
// (Postgres convierte a minúscula los nombres sin comillas del script original).
// NO editar a mano sin crear la migración correspondiente (ver README).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Catálogos
// -----------------------------------------------------------------------------

model Estado {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(200)

  recursos   Recurso[]
  usuarios   Usuario[]
  tutorias   Tutoria[]
  horarios   Horario[]
  reservas   Reserva[]
  solicitudesTutor SolicitudTutor[]
  solicitudesTutoria SolicitudTutoria[]

  @@map("tbl_estado")
}

model Rol {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(200)

  usuarios Usuario[]

  @@map("tbl_rol")
}

model TipoDocumento {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(200)

  usuarios Usuario[]

  @@map("tbl_tipo_documento")
}

model Materia {
  id       Int    @id @default(autoincrement())
  nombre   String @db.VarChar(200)
  codigo   String @unique @db.VarChar(50)
  creditos Int

  tutores  MateriaTutor[]
  tutorias Tutoria[]
  solicitudesTutoria SolicitudTutoria[]

  @@map("tbl_materia")
}

model Recurso {
  id        Int    @id @default(autoincrement())
  nombre    String @db.VarChar(200)
  tipo      String @db.VarChar(50) // 'Físico' | 'Virtual'
  ubicacion String @db.VarChar(255) // Salón/Bloque o enlace (Meet/Zoom)
  capacidad Int    @default(1)
  id_estado Int
  generado  Boolean @default(false) // sala Jitsi creada por el sistema para una tutoría Virtual

  estado         Estado    @relation(fields: [id_estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_recurso_estado")
  horarios       Horario[]
  reservas       Reserva[]
  tutoria_enlace Tutoria?  @relation("EnlaceTutoria")

  @@map("tbl_recurso")
}

// -----------------------------------------------------------------------------
// Usuarios y datos académicos
// -----------------------------------------------------------------------------

model Usuario {
  id                Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(200)
  apellido          String    @db.VarChar(200)
  id_tipo_documento Int
  num_documento     String    @unique @db.VarChar(50)
  correo            String    @unique @db.VarChar(200)
  celular           String?   @db.VarChar(20)
  /// En desuso: el rol se determina con id_rol (3 = Administrador).
  es_administrador  Boolean   @default(false)
  /// Nivel de permisos: 1 Estudiante (todos), 2 Estudiante + Tutor (solicitud aprobada), 3 Administrador.
  fecha_registro    DateTime? @default(now()) @db.Timestamp(6)
  id_estado         Int
  id_rol            Int
  contrasena_hash   String    @db.VarChar(255)

  tipoDocumento TipoDocumento  @relation(fields: [id_tipo_documento], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_tipo_doc")
  estado        Estado         @relation(fields: [id_estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_estado")
  rol           Rol            @relation(fields: [id_rol], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_rol")
  estudiante    Estudiante?
  materias      MateriaTutor[]
  tutorias      Tutoria[]
  reservas      Reserva[]
  valoraciones  Valoracion[]
  solicitudesTutor  SolicitudTutor[] @relation("solicitante")
  revisionesTutor   SolicitudTutor[] @relation("revisor")
  notificaciones    Notificacion[]
  solicitudesTutoria   SolicitudTutoria[] @relation("solicitudTutoriaEstudiante")
  solicitudesAtendidas SolicitudTutoria[] @relation("solicitudTutoriaTutor")

  @@map("tbl_usuario")
}

model Estudiante {
  id              Int    @id @default(autoincrement())
  id_usuario      Int    @unique
  nombre_programa String @db.VarChar(200)
  semestre        Int

  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_estudiante_usuario")

  @@map("tbl_estudiante")
}

model MateriaTutor {
  id         Int @id @default(autoincrement())
  id_tutor   Int
  id_materia Int

  tutor   Usuario @relation(fields: [id_tutor], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_matxtutor_tutor")
  materia Materia @relation(fields: [id_materia], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_matxtutor_materia")

  @@unique([id_tutor, id_materia], map: "unique_tutor_materia")
  @@map("tbl_materia_x_tutor")
}

// -----------------------------------------------------------------------------
// Tutorías, horarios y reservas
// -----------------------------------------------------------------------------

model Tutoria {
  id          Int       @id @default(autoincrement())
  id_tutor    Int
  id_materia  Int
  id_estado   Int
  titulo      String    @db.VarChar(200)
  descripcion String?
  nivel       String?   @db.VarChar(50) // 'Básico' | 'Intermedio' | 'Avanzado'
  modalidad   String?   @db.VarChar(50) // 'Presencial' | 'Virtual' | 'Híbrida'
  cupo        Int       @default(1)
  fecha       DateTime? @default(now()) @db.Timestamp(6) // fecha de creación
  id_recurso_enlace Int? @unique // sala Jitsi propia (solo tutorías Virtuales)

  enlace   Recurso?  @relation("EnlaceTutoria", fields: [id_recurso_enlace], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tutoria_recurso_enlace")
  tutor    Usuario   @relation(fields: [id_tutor], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tutoria_tutor")
  materia  Materia   @relation(fields: [id_materia], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tutoria_materia")
  estado   Estado    @relation(fields: [id_estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tutoria_estado")
  horarios Horario[]
  solicitudesAtendidas SolicitudTutoria[]

  @@map("tbl_tutoria")
}

model Horario {
  id          Int      @id @default(autoincrement())
  id_tutoria  Int
  id_estado   Int
  dia         String   @db.VarChar(20) // 'Lunes' ... 'Domingo'
  hora_inicio DateTime @db.Time(6)
  hora_fin    DateTime @db.Time(6)
  id_recurso  Int // salón o enlace fijo del bloque semanal

  tutoria  Tutoria   @relation(fields: [id_tutoria], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_horario_tutoria")
  estado   Estado    @relation(fields: [id_estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_horario_estado")
  recurso  Recurso   @relation(fields: [id_recurso], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_horario_recurso")
  reservas Reserva[]

  @@map("tbl_horario")
}

model Reserva {
  id                     Int       @id @default(autoincrement())
  id_usuario_estudiante  Int
  id_horario             Int
  id_recurso             Int // copia de horario.id_recurso al reservar
  id_estado              Int
  fecha                  DateTime? @default(now()) @db.Timestamp(6) // cuándo se hizo la reserva
  fecha_sesion           DateTime  @db.Date // día concreto en que ocurre la sesión

  estudiante Usuario     @relation(fields: [id_usuario_estudiante], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reserva_estudiante")
  horario    Horario     @relation(fields: [id_horario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reserva_horario")
  recurso    Recurso     @relation(fields: [id_recurso], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reserva_recurso")
  estado     Estado      @relation(fields: [id_estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reserva_estado")
  valoracion Valoracion?

  @@map("tbl_reserva")
}

model Valoracion {
  id                   Int       @id @default(autoincrement())
  id_reserva           Int       @unique
  calificacion         Int // CHECK 1..5 en la BD
  comentario           String?
  fecha                DateTime? @default(now()) @db.Timestamp(6)
  id_usuario_evaluador Int

  reserva   Reserva @relation(fields: [id_reserva], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_valoracion_reserva")
  evaluador Usuario @relation(fields: [id_usuario_evaluador], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_valoracion_evaluador")

  @@map("tbl_valoracion")
}

// -----------------------------------------------------------------------------
// Solicitudes para ser tutor
// -----------------------------------------------------------------------------

/// Historial de solicitudes: Pendiente (3) → Aprobado (6) o Rechazado (7). Al aprobarse, id_rol pasa de 1 a 2.
/// Índice único parcial en la migración (Prisma no lo declara): una sola solicitud PENDIENTE por usuario.
model SolicitudTutor {
  id              Int       @id @default(autoincrement())
  id_usuario      Int
  id_estado       Int
  motivo          String?
  fecha_solicitud DateTime  @default(now()) @db.Timestamp(6)
  id_revisor      Int?
  fecha_revision  DateTime? @db.Timestamp(6)
  observacion     String?

  usuario Usuario  @relation("solicitante", fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_solicitud_tutor_usuario")
  estado  Estado   @relation(fields: [id_estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitud_tutor_estado")
  revisor Usuario? @relation("revisor", fields: [id_revisor], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitud_tutor_revisor")

  @@index([id_usuario], map: "idx_solicitud_tutor_usuario")
  @@map("tbl_solicitud_tutor")
}

// Avisos dentro de la plataforma (campanita). Se crean en los eventos (reserva nueva, cancelación,
// sesión completada, solicitudes de tutor...). Las leídas se borran a los 30 días.
model Notificacion {
  id          Int       @id @default(autoincrement())
  id_usuario  Int
  tipo        String    @db.VarChar(40) // ver TIPO en notificaciones.service.js
  titulo      String    @db.VarChar(200)
  mensaje     String?
  enlace      String?   @db.VarChar(255) // ruta del frontend: "/mis-reservas"
  leida       Boolean   @default(false)
  fecha       DateTime  @default(now()) @db.Timestamp(6)
  fecha_leida DateTime? @db.Timestamp(6)

  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notificacion_usuario")

  @@index([id_usuario, leida, fecha(sort: Desc)], map: "idx_notificacion_usuario")
  @@map("tbl_notificacion")
}

// Un estudiante pide una tutoría que no encuentra en el catálogo; la atiende un tutor de esa materia.
// Estados (catálogo existente): PENDIENTE (3) abierta → COMPLETADO (5) atendida | CANCELADO (4) la
// retiró el estudiante | INACTIVO (2) venció sin respuesta (30 días).
model SolicitudTutoria {
  id             Int       @id @default(autoincrement())
  id_estudiante  Int
  id_materia     Int
  tema           String    @db.VarChar(200)
  descripcion    String?
  disponibilidad String?   @db.VarChar(300) // texto libre: "martes y jueves en la tarde"
  id_estado      Int
  fecha          DateTime  @default(now()) @db.Timestamp(6)
  id_tutor       Int? // quien la atendió
  id_tutoria     Int? // tutoría con que la atendió
  fecha_atencion DateTime? @db.Timestamp(6)

  estudiante Usuario  @relation("solicitudTutoriaEstudiante", fields: [id_estudiante], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_solicitud_tutoria_estudiante")
  materia    Materia  @relation(fields: [id_materia], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitud_tutoria_materia")
  estado     Estado   @relation(fields: [id_estado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_solicitud_tutoria_estado")
  tutor      Usuario? @relation("solicitudTutoriaTutor", fields: [id_tutor], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_solicitud_tutoria_tutor")
  tutoria    Tutoria? @relation(fields: [id_tutoria], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_solicitud_tutoria_tutoria")

  @@index([id_materia, id_estado], map: "idx_solicitud_tutoria_materia")
  @@index([id_estudiante, id_estado], map: "idx_solicitud_tutoria_estudiante")
  @@map("tbl_solicitud_tutoria")
}
