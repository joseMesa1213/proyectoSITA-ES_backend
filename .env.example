# Copiar a .env y completar. Las URLs están en Supabase → Project Settings → Database → Connection string.

# Conexión por pooler (puerto 6543) — la usa la app en ejecución
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) — la usa la CLI de Prisma (migraciones)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORT=3000
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"
# Orígenes del frontend, separados por coma (local de Vite y el desplegado)
CORS_ORIGIN="http://localhost:5173"

# Inicio de sesión con Google (opcional). Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (Web).
# Debe ser el mismo VITE_GOOGLE_CLIENT_ID del frontend. Sin esta variable, POST /auth/google responde 503.
GOOGLE_CLIENT_ID="609971080288-h4ukg49ic8h71rc3jvdidhcjkv3o58i6.apps.googleusercontent.com"
# Dominio de correo permitido con Google (sin @). Por defecto: udea.edu.co
GOOGLE_DOMINIO="udea.edu.co"

# Login con correo y contraseña (POST /auth/login). SOLO PARA DESARROLLO: las cuentas de la semilla y Postman.
# Apagado por defecto: sin esta variable (o con cualquier valor distinto de true) responde 403 y pide usar Google.
# En producción (Render) NO se define.
LOGIN_CONTRASENA=true

# Servidor Jitsi para las salas automáticas de las tutorías Virtuales (opcional).
# Por defecto el público y gratuito https://meet.jit.si; cambiar solo si se usa un servidor propio.
# JITSI_URL="https://meet.jit.si"
